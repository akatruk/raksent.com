# Managed by infrastructure/ansible/site.yml; local edits are overwritten.
[Unit]
Description=Deploy the latest verified RAKSENT release from GitHub main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/raksent-deploy
TimeoutStartSec=10min
StateDirectory=raksent-deploy
StateDirectoryMode=0700
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/raksent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
