#!/usr/bin/env python3
"""Email each new website inquiry to the owner once.

raksent-lead-notify          send notifications for inquiries that have not been sent yet
raksent-lead-notify --test   send a test message to check the SMTP settings
"""

import argparse
import json
import os
import re
import smtplib
import ssl
import sys
from email.message import EmailMessage
from pathlib import Path

LEADS = Path("/var/lib/raksent/leads")
CONFIG = Path("/etc/raksent/lead-notify.json")
STATE = Path(os.environ.get("STATE_DIRECTORY", "/var/lib/raksent-notify"))
CREDENTIALS = Path(os.environ.get("CREDENTIALS_DIRECTORY", "/etc/raksent"))
REFERENCE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}")
EMAIL = re.compile(r"[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+")
FIELDS = (
    ("Name", "name"),
    ("Work email", "email"),
    ("Organization", "organization"),
    ("Service", "service"),
    ("Received", "receivedAt"),
)


def pending(leads, sent):
    for path in sorted(leads.glob("*.json")):
        if REFERENCE.fullmatch(path.stem) and not (sent / path.stem).exists():
            yield path


def one_line(value):
    return " ".join(str(value).split())


def compose(lead, config):
    """Build the notification. Inquiry text is untrusted, so only the validated reply address reaches a header."""
    message = EmailMessage()
    message["Subject"] = f"New RAKSENT inquiry {lead['id']}"
    message["From"] = config["from"]
    message["To"] = config["to"]
    if EMAIL.fullmatch(str(lead.get("email", ""))):
        message["Reply-To"] = lead["email"]
    details = "\n".join(f"{label}: {one_line(lead.get(key, ''))}" for label, key in FIELDS)
    message.set_content(f"{details}\n\n{lead.get('message', '')}\n")
    return message


def test_message(config):
    message = EmailMessage()
    message["Subject"] = "RAKSENT inquiry notifications are working"
    message["From"] = config["from"]
    message["To"] = config["to"]
    message.set_content("New website inquiries will be sent to this address.\n")
    return message


def connect(config):
    context = ssl.create_default_context()
    port = int(config.get("port", 587))
    if port == 465:
        client = smtplib.SMTP_SSL(config["host"], port, context=context, timeout=30)
    else:
        client = smtplib.SMTP(config["host"], port, timeout=30)
        client.starttls(context=context)
    client.login(config["user"], (CREDENTIALS / "smtp-password").read_text().strip())
    return client


def main():
    parser = argparse.ArgumentParser(description="Email new RAKSENT website inquiries.")
    parser.add_argument("--test", action="store_true", help="send a test message to check the SMTP settings")
    args = parser.parse_args()
    config = json.loads(CONFIG.read_text())
    if args.test:
        with connect(config) as client:
            client.send_message(test_message(config))
        print(f"Test message sent to {config['to']}")
        return 0

    sent = STATE / "sent"
    sent.mkdir(mode=0o700, parents=True, exist_ok=True)
    batch = []
    for path in pending(LEADS, sent):
        try:
            lead = json.loads(path.read_text())
        except (OSError, ValueError):
            print(f"Skipping unreadable inquiry {path.name}")
            continue
        if lead.get("id") == path.stem:
            batch.append((path.stem, compose(lead, config)))
    if not batch:
        return 0
    with connect(config) as client:
        for reference, message in batch:
            client.send_message(message)
            (sent / reference).touch()
    print(f"Sent {len(batch)} inquiry notification(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
