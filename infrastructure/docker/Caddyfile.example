# Merge this into the existing ingress configuration only after the VPS audit.
# A conflicting site block or listener requires a separate migration plan.
raksent.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-X-Powered-By
		-Server
	}
	@internal path /readyz
	respond @internal 404
	reverse_proxy 127.0.0.1:18080
}

# Use this block only after checking the existing www site and certificate.
www.raksent.com {
	redir https://raksent.com{uri} permanent
}
